      "children": [
        {
          "type": "text",
          "id": "VIUuJ",
          "name": "BehaviorTitle",
          "fill": "$text-primary",
          "content": "Cross-Platform Behavior Spec",
          "fontFamily": "Inter",
          "fontSize": "$text-xl",
          "fontWeight": "700"
        },
        {
          "type": "text",
          "id": "owClW",
          "name": "BehaviorBody",
          "fill": "$text-secondary",
          "textGrowth": "fixed-width",
          "width": 352,
          "content": "Invocation: global hotkey opens overlay near cursor.\nDismissal: Esc, click outside, or hotkey again.\nAuto-paste: selecting item immediately pastes (configurable).\nTray: system tray (Win/Linux), menu bar (macOS).\nWindow: frameless overlay with OS shadows and rounded corners.\n\nTech Stack: Tauri + Rust backend + Web frontend.\n- Lightweight binary (< 10MB)\n- Native API access for hotkeys, clipboard, tray\n- Cross-platform packaging via Tauri CLI",
          "fontFamily": "Inter",
          "fontSize": 11,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "qV6YC",
          "name": "ChecklistTitle",
          "fill": "$text-primary",
          "content": "Handoff Checklist",
          "fontFamily": "Inter",
          "fontSize": "$text-lg",
          "fontWeight": "700"
        },
        {
          "type": "text",
          "id": "Fr2qc",
          "name": "ChecklistBody",
          "fill": "$text-secondary",
          "textGrowth": "fixed-width",
          "width": 352,
          "content": "[x] Brand tokens finalized\n[x] Design system components created and reusable\n[x] All screens mocked using component refs\n[x] Component audit passed - no orphaned primitives\n[ ] Behavior spec agreed upon\n[ ] Tech stack chosen\n[ ] Feature backlog prioritized",
          "fontFamily": "Inter",
          "fontSize": 11,
          "fontWeight": "normal"
        }
      ]
    }
